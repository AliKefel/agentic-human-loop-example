# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings > API Keys > publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings > API Keys > secret key (server only, never expose)
SUPABASE_SECRET_KEY=
# Project Settings > Database > Connection string (used by `pnpm db:reset`, server only)
SUPABASE_DB_URL=

# Optional. Leave empty to run in Mock mode (no API calls, deterministic fixtures).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Set to true to force Mock mode even when ANTHROPIC_API_KEY is set
NEXT_PUBLIC_MOCK_MODE=
